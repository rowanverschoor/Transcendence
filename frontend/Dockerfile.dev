# Dev image for the frontend: full deps + source bind-mounted in,
# served by the Angular dev server (see docker-compose.dev.yml).
# Build from the repo root: docker build -t frontend-dev -f frontend/Dockerfile.dev .
FROM node:22.23-trixie-slim

WORKDIR /app

# Manifests only first, for dependency-cache reuse. Needs devDependencies
# (@angular/cli, @angular/build), so no --omit=dev here.
COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY frontend/package.json frontend/package.json

RUN npm ci -w frontend

COPY shared/ shared/
COPY frontend/ frontend/

WORKDIR /app/frontend
# Source is bind-mounted over /app/frontend at runtime, so COPY is only
# needed so the image builds standalone.
ENTRYPOINT ["npx", "ng", "serve", "--host", "0.0.0.0", "--proxy-config", "proxy.conf.docker.json"]
