    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
