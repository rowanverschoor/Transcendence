  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "start": "npm run build && node dist/main.js",
    "build": "tsc && sass --no-source-map --style=compressed styles/main.scss dist/styles.css",
    "watch:css": "sass --no-source-map --watch styles/main.scss dist/styles.css",
    "check": "tsc --noEmit",
    "serve": "node --experimental-strip-types --watch main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowanverschoor/Transcendence.git"
  },
