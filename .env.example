# Example environment file. Copy to .env and adjust before running.
# Backend boot validates this via env.schema.ts and refuses bad/placeholder
# values in production.

# "development" allows the dev placeholder SESSION_SECRET; "production"
# requires a real secret.
NODE_ENV=production

# Backend HTTP listener (must match the "8080:8080" mapping in docker-compose.yml)
PORT=8080

# Session-cookie signing secret. Generate e.g. with: openssl rand -hex 32
SESSION_SECRET=
DATABASE_URL=postgres://transcendence:transcendence@localhost:5433/transcendence

# Gameplay tuning (valid ranges in env.schema.ts; shown values are defaults)
ROOM_CAPACITY=10
ARENA_WIDTH=800
ARENA_HEIGHT=800
FOOD_RADIUS=5
N_FOOD_CHUNKS=50

# Cloudflare tunnel token for the cloudflared service in docker-compose.yml
TUNNEL_TOKEN=
